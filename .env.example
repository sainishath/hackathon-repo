# LLM Provider: gemini | ollama | mock
LLM_PROVIDER=mock

# Gemini API configuration (if using gemini provider)
GEMINI_API_KEY=

# Ollama configuration (if using ollama provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Dense Retriever Model (sentence-transformers)
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
# If set to true, dense retrieval uses deterministic offline fallback vectors
OFFLINE_EMBEDDINGS=true
